{
  "name": "clarityrail",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "From messy instructions to one clear, traceable next step. Local-first cognitive-accessibility workspace for Taskforge Hackathon 2026.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "benchmark:rules": "tsx scripts/run-benchmark.ts",
    "evidence:check": "tsx scripts/check-evidence.ts",
    "evidence:report": "tsx scripts/generate-evidence-report.ts",
    "generate:assets": "tsx scripts/render-assets.ts",
    "security-scan": "tsx scripts/security-scan.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run benchmark && npm run security-scan && npm run audit && npm run evidence:check && npm run build && npm run test:e2e && npm run evidence:report"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
